<div
  id="batch-detail-view"
  phx-hook="BatchDetailLoader"
  data-batch-id={@batch_id}
  class="min-h-screen bg-sticker-cream font-body text-sticker-ink"
>
  <div class="relative mx-auto flex min-h-screen w-full max-w-[420px] flex-col px-6 pb-6 pt-3.5">
    <!-- Nav -->
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-white shadow-[3px_3px_0_0_rgba(43,42,61,0.15)] outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]"
        aria-label="Back to home"
      >
        {icon(:arrow_left, "h-[18px] w-[18px] text-sticker-ink")}
      </a>
      <h1 class="font-display text-[26px] font-extrabold text-sticker-ink">Batch Detail</h1>
      <div class="h-10 w-10 shrink-0"></div>
    </div>

    <%= if @error do %>
      <div class="mt-6 rounded-[20px] bg-white p-4 shadow-sticker-card outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]" role="alert">
        <p class="text-[15px] font-medium text-sticker-ink">Couldn't load batch data — the payload was invalid.</p>
        <a href="/" class="mt-3 inline-block rounded-[40px] bg-sticker-yellow px-4 py-2 font-display text-sm font-semibold text-sticker-ink outline-2 outline-solid outline-sticker-ink outline-offset-[-1px]">Back home</a>
      </div>
    <% else %>
      <%= if @batch do %>
        <!-- Info card -->
        <div class="mt-6 flex w-full flex-col gap-2 rounded-[20px] bg-white p-4 shadow-[4px_4px_0_0_rgba(43,42,61,0.1)] outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]">
          <h2 class="truncate font-display text-[22px] font-bold text-sticker-ink"><%= @batch["name"] %></h2>
          <div class="flex items-center gap-2 text-[12.5px] font-medium text-sticker-muted">
            <span><%= symbology_name(@batch) %></span>
            <span>·</span>
            <span><%= length(@codes) %> labels</span>
            <%= if @batch["created_at"] do %>
              <span>·</span>
              <span><%= String.slice(@batch["created_at"] || "", 0, 10) %></span>
            <% end %>
          </div>
          <div class="mt-1 flex gap-2">
            <a
              href={"/sheet/" <> @batch["id"]}
              class="flex flex-1 items-center justify-center gap-2 rounded-[40px] bg-sticker-coral p-[10px_16px] shadow-sticker outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]"
            >
              {icon(:printer, "h-[16px] w-[16px] text-sticker-ink")}
              <span class="font-display text-[15px] font-semibold text-sticker-ink">Print</span>
            </a>
            <a
              href="/scan"
              class="flex flex-1 items-center justify-center gap-2 rounded-[40px] bg-white p-[10px_16px] outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]"
            >
              {icon(:scan, "h-[16px] w-[16px] text-sticker-ink")}
              <span class="font-display text-[15px] font-semibold text-sticker-ink">Scan</span>
            </a>
          </div>
        </div>

        <!-- Codes -->
        <%= if @codes == [] do %>
          <div class="mt-3 rounded-[16px] bg-white p-6 text-center text-sm font-medium text-sticker-muted shadow-sticker-card outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]">No codes in this batch yet.</div>
        <% else %>
          <ul class="mt-3 flex flex-col gap-3">
            <li :for={code <- @codes}>
              <a
                href={"/codes/" <> code["id"]}
                class="flex items-start justify-between gap-3 rounded-[16px] bg-white p-3.5 shadow-sticker-card outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px] transition-colors hover:bg-sticker-cream"
              >
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class="truncate font-mono text-[12px] font-semibold text-sticker-ink"><%= code["code_data"] %></span>
                  <span class="text-[11px] font-medium text-sticker-muted">Seq: <%= code["sequence"] %></span>
                  <div class="mt-1 flex flex-wrap gap-1.5">
                    <span :for={field <- code["fields"] || []} class="rounded-[8px] bg-sticker-cream px-2 py-1 text-[11px] font-medium text-sticker-ink outline-2 outline-solid outline-sticker-ink outline-offset-[-1px]"><%= field["name"] %>: <%= field["value"] %></span>
                  </div>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-1.5">
                  <span class="rounded-[10px] bg-sticker-yellow px-2 py-1 text-[11px] font-bold text-sticker-ink outline-2 outline-solid outline-sticker-ink outline-offset-[-1px]"><%= code["symbology"] || "code" %></span>
                  {icon(:chevron, "h-[16px] w-[16px] text-sticker-muted")}
                </div>
              </a>
            </li>
          </ul>
        <% end %>

        <!-- Delete -->
        <button
          type="button"
          id="batch-detail-delete"
          class="mt-4 flex w-full items-center justify-center gap-2 rounded-[40px] bg-white p-[14px_24px] outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]"
          phx-hook="SheetDelete"
          data-batch-id={@batch["id"]}
        >
          {icon(:trash_2, "h-[18px] w-[18px] text-sticker-coral")}
          <span class="font-display text-[16px] font-semibold text-sticker-coral">Delete batch</span>
        </button>
      <% else %>
        <div class="py-24 text-center text-sm font-medium text-sticker-muted">Loading batch…</div>
      <% end %>
    <% end %>
  </div>
</div>
