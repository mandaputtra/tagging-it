<div
  id="code-detail-view"
  phx-hook="CodeDetailLoader"
  data-code-id={@code_id}
  class="min-h-screen bg-sticker-cream font-body text-sticker-ink"
>
  <div class="relative mx-auto flex min-h-screen w-full max-w-[420px] flex-col gap-3 px-4 pb-6 pt-3.5">
    <!-- Nav -->
    <div class="flex items-center justify-between px-2 pt-[2px]">
      <a
        href={if @batch, do: "/batches/" <> @batch["id"], else: "/"}
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-white shadow-[3px_3px_0_0_rgba(43,42,61,0.15)] outline-[3px] outline-solid outline-sticker-ink outline-offset-[-1.5px]"
        aria-label="Back to batch"
      >
        {icon(:arrow_left, "h-[18px] w-[18px] text-sticker-ink")}
      </a>
      <h1 class="font-display text-[26px] font-extrabold text-sticker-ink">Detail</h1>
      <div class="h-10 w-10 shrink-0"></div>
    </div>

    <%= if @error do %>
      <div
        class="rounded-[20px] bg-white p-4 shadow-[5px_5px_0_0_rgba(43,42,61,0.1)] outline outline-[3px] outline-sticker-ink outline-offset-[-1.5px]"
        role="alert"
      >
        <p class="text-[15px] font-medium text-sticker-ink">
          Couldn't load code — the payload was invalid.
        </p>
        <a
          href="/"
          class="mt-3 inline-block rounded-full bg-sticker-yellow px-4 py-2 font-display text-sm font-semibold text-sticker-ink outline outline-2 outline-sticker-ink outline-offset-[-1px]"
        >Back home</a>
      </div>
    <% else %>
      <%= if @code do %>
        <!-- Code Card — Barcode + Code Value + Pill Row -->
        <div class="flex flex-col items-center gap-[10px] rounded-[20px] bg-white p-[18px] shadow-[5px_5px_0_0_rgba(43,42,61,0.1)] outline outline-[3px] outline-sticker-ink outline-offset-[-1.5px]">
          <div class="flex justify-center">
            <div
              class="barcode"
              data-bcid={@code["symbology"] || "code128"}
              data-text={@code["code_data"]}
              role="img"
              aria-label={"Barcode #{@code["code_data"]}"}
            >
            </div>
          </div>
          <div class="font-display text-[22px] font-bold tracking-[1px] text-sticker-ink">
            {@code["code_data"]}
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1 rounded-full bg-sticker-grape px-[10px] py-1 text-[12px] font-bold text-white outline outline-2 outline-sticker-ink outline-offset-[-1px]">
              {icon(:qr, "h-3 w-3 text-white")}
              <span>{symbology_name(@code)}</span>
            </span>
            <span class="inline-flex items-center rounded-full bg-sticker-yellow px-[10px] py-1 text-[12px] font-bold text-sticker-ink outline outline-2 outline-sticker-ink outline-offset-[-1px]">
              {@batch["name"] || "Batch"}
            </span>
          </div>
        </div>

        <!-- Details Card — Batch / Code type / Label size / Created -->
        <div class="flex flex-col rounded-[20px] bg-white px-4 py-[6px] shadow-[5px_5px_0_0_rgba(43,42,61,0.1)] outline outline-[3px] outline-sticker-ink outline-offset-[-1.5px]">
          <div class="flex items-center justify-between py-[13px]">
            <span class="text-[13px] font-medium text-sticker-muted">Batch</span>
            <span class="max-w-[170px] truncate text-right text-[13.5px] font-semibold text-sticker-ink">{@batch[
              "name"
            ] || "—"}</span>
          </div>
          <div class="h-[2px] w-full bg-sticker-cream"></div>
          <div class="flex items-center justify-between py-[13px]">
            <span class="text-[13px] font-medium text-sticker-muted">Code type</span>
            <span class="text-[13.5px] font-semibold text-sticker-ink">{symbology_name(@code)}</span>
          </div>
          <div class="h-[2px] w-full bg-sticker-cream"></div>
          <div class="flex items-center justify-between py-[13px]">
            <span class="text-[13px] font-medium text-sticker-muted">Label size</span>
            <span class="max-w-[170px] truncate text-right text-[13.5px] font-semibold text-sticker-ink">{label_size_name(
              @batch
            )}</span>
          </div>
          <div class="h-[2px] w-full bg-sticker-cream"></div>
          <div class="flex items-center justify-between py-[13px]">
            <span class="text-[13px] font-medium text-sticker-muted">Created</span>
            <span class="text-[13.5px] font-semibold text-sticker-ink">{format_created(
              @batch["created_at"] || @code["created_at"]
            )}</span>
          </div>
        </div>

        <!-- Fields — when code has free-form fields, show after details -->
        <%= if @code["fields"] && @code["fields"] != [] do %>
          <div class="flex flex-col rounded-[20px] bg-white px-4 py-[6px] shadow-[5px_5px_0_0_rgba(43,42,61,0.1)] outline outline-[3px] outline-sticker-ink outline-offset-[-1.5px]">
            <div :for={{field, idx} <- Enum.with_index(@code["fields"])} class="contents">
              <div class="flex items-center justify-between py-[13px]">
                <span class="max-w-[120px] truncate text-[13px] font-medium text-sticker-muted">{field[
                  "name"
                ]}</span>
                <span class="max-w-[170px] truncate text-right text-[13.5px] font-semibold text-sticker-ink">{field[
                  "value"
                ]}</span>
              </div>
              <div :if={idx < length(@code["fields"]) - 1} class="h-[2px] w-full bg-sticker-cream">
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="py-24 text-center text-sm font-medium text-sticker-muted">Loading code…</div>
      <% end %>
    <% end %>
  </div>
</div>
