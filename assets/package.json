{
  "name": "tagging-it-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i css/app.css -o ../priv/static/assets/app.css --minify",
    "css:watch": "tailwindcss -i css/app.css -o ../priv/static/assets/app.css --watch",
    "build": "tsc --noEmit && npm run css && esbuild js/app.ts --bundle --outdir=../priv/static/assets --target=es2017 --format=esm --sourcemap",
    "deploy": "npm run build"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "idb": "^8.0.3",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.27.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}