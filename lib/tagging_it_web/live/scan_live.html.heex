<div
  id="scan-view"
  phx-hook="ScanLoader"
  class="min-h-screen bg-sticker-cream font-body text-sticker-ink"
>
  <div class="relative mx-auto flex min-h-screen w-full max-w-[420px] flex-col px-6 pb-6 pt-3.5">
    <!-- Nav -->
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-white shadow-[3px_3px_0_0_rgba(43,42,61,0.15)] outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]"
        aria-label="Back to home"
      >
        {icon(:arrow_left, "h-[18px] w-[18px] text-sticker-ink")}
      </a>
      <h1 class="font-display text-[22px] font-extrabold text-sticker-ink">Scan Label</h1>
      <div class="h-10 w-10 shrink-0"></div>
    </div>

    <!-- Variant A: camera viewport + manual fallback (winner per #21) -->
    <div id="scan-camera" class="mt-6 rounded-[20px] bg-black p-2 outline-3 outline-solid outline-sticker-ink">
      <div class="h-[220px] rounded-[14px] bg-zinc-900 flex items-center justify-center text-white/70 text-sm">Camera viewport — video placeholder</div>
      <div class="mt-2 flex gap-2">
        <button type="button" class="flex-1 rounded-[40px] bg-sticker-coral py-2.5 text-sm font-semibold outline-2 outline-solid outline-sticker-ink">Start camera</button>
        <button type="button" class="flex-1 rounded-[40px] bg-white py-2.5 text-sm font-semibold outline-2 outline-solid outline-sticker-ink">Stop</button>
      </div>
    </div>

    <!-- Manual fallback -->
    <div class="mt-3 rounded-[20px] bg-white p-4 shadow-sticker-card outline-3 outline-solid outline-sticker-ink outline-offset-[-1.5px]">
      <label class="text-[12px] font-semibold">Or type / paste code</label>
      <div class="mt-2 flex gap-2">
        <input
          id="scan-input"
          type="text"
          class="flex-1 rounded-[12px] border-2 border-sticker-ink px-3 py-2.5 font-mono text-sm outline-none"
          placeholder="CODEPRODUCT00000120260101"
          value={@scan_value}
          phx-hook="ScanInput"
        />
        <button
          id="scan-verify"
          type="button"
          class="rounded-[40px] bg-sticker-yellow px-5 py-2.5 text-sm font-semibold outline-2 outline-solid outline-sticker-ink"
        >
          Verify
        </button>
      </div>
      <p class="mt-2 text-[11px] text-sticker-muted">Input is the pivot; camera enhances the same string. Press Enter to verify.</p>
    </div>

    <!-- Miss popup -->
    <%= if @show_miss do %>
      <div id="scan-miss" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" phx-click="scan:clear" role="dialog" aria-modal="true">
        <div class="w-[340px] rounded-[20px] bg-white p-6 outline-3 outline-solid outline-sticker-ink shadow-sticker" phx-click-away="scan:clear">
          <h3 class="font-display text-xl font-extrabold text-center">Code not found</h3>
          <p class="mt-2 text-sm text-center text-sticker-muted">
            “<span class="font-mono"><%= @miss_value %></span>” isn’t in this browser’s store.
          </p>
          <div class="mt-4 flex gap-2">
            <button type="button" phx-click="scan:clear" class="flex-1 rounded-[40px] bg-sticker-yellow py-2.5 text-sm font-semibold outline-2 outline-solid outline-sticker-ink">Try again</button>
            <a href="/" class="flex-1 rounded-[40px] bg-white py-2.5 text-center text-sm font-semibold outline-2 outline-solid outline-sticker-ink">Go to batches</a>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
