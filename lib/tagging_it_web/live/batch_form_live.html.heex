<div id="batch-form-view" phx-hook="BatchCreator">
  <h1>New batch</h1>

  <%= if @errors != [] do %>
    <div class="form-errors" role="alert">
      <%= for error <- @errors do %>
        <p class="form-error"><%= error %></p>
      <% end %>
    </div>
  <% end %>

  <form id="batch-form" phx-submit="create_batch">
    <div class="field">
      <label for="batch-name">Batch name</label>
      <input id="batch-name" type="text" name="batch[name]" value={@form.name} placeholder="Products" />
    </div>

    <fieldset class="field">
      <legend>Input mode</legend>
      <label><input type="radio" name="batch[mode]" value="pattern" checked={@form.mode == "pattern"} phx-click="set_mode" phx-value-mode="pattern" /> Generate (sequence)</label>
      <label><input type="radio" name="batch[mode]" value="ulid" checked={@form.mode == "ulid"} phx-click="set_mode" phx-value-mode="ulid" /> Generate (ULID)</label>
      <label><input type="radio" name="batch[mode]" value="paste" checked={@form.mode == "paste"} phx-click="set_mode" phx-value-mode="paste" /> Paste values</label>
    </fieldset>

    <%= if @form.mode != "paste" do %>
      <div class="field" id="pattern-fields">
        <label for="batch-prefix">Prefix</label>
        <input id="batch-prefix" type="text" name="batch[prefix]" value={@form.prefix} placeholder="CODEPRODUCT" />

        <label for="batch-start">Start</label>
        <input id="batch-start" type="number" name="batch[start]" value={@form.start} min="1" />

        <label for="batch-count">Count</label>
        <input id="batch-count" type="number" name="batch[count]" value={@form.count} min="1" />

        <%= if @form.mode == "pattern" do %>
          <label for="batch-date">Date</label>
          <input id="batch-date" type="date" name="batch[date]" value={@form.date} />
        <% end %>
      </div>
    <% else %>
      <div class="field" id="paste-fields">
        <label for="batch-paste">Code data — one value per line</label>
        <textarea id="batch-paste" name="batch[paste]" rows="6" placeholder={"SN-001\nSN-002\nSN-003"}><%= @form.paste %></textarea>
      </div>
    <% end %>

    <div class="field">
      <label for="batch-label-size">Label size</label>
      <select id="batch-label-size" name="batch[label_size]">
        <%= for size <- @label_sizes do %>
          <option value={size.id} selected={@form.label_size == size.id}><%= size.name %></option>
        <% end %>
      </select>
    </div>

    <div class="field">
      <label>Label fields (name + shared value)</label>
      <div id="fields-editor">
        <%= for {field, index} <- Enum.with_index(@fields) do %>
          <div class="field-row" data-index={index}>
            <input type="text" name={"fields[#{index}][name]"} value={field.name} placeholder="SKU" />
            <input type="text" name={"fields[#{index}][value]"} value={field.value} placeholder={"(shared value)"} />
            <button type="button" phx-click="remove_field" phx-value-index={index}>×</button>
          </div>
        <% end %>
      </div>
      <button type="button" phx-click="add_field">+ add field</button>
    </div>

    <button type="submit">Create batch</button>
  </form>
</div>

<style>
  #batch-form-view { max-width: 640px; margin: 0 auto; padding: 32px 16px; font-family: system-ui, -apple-system, sans-serif; }
  #batch-form-view h1 { font-size: 24px; font-weight: 600; margin-bottom: 20px; }
  #batch-form-view .field { margin-bottom: 16px; }
  #batch-form-view label { display: block; font-size: 13px; font-weight: 500; margin-bottom: 4px; }
  #batch-form-view fieldset.field label { display: inline-block; margin-right: 16px; font-weight: 400; }
  #batch-form-view input[type="text"],
  #batch-form-view input[type="number"],
  #batch-form-view input[type="date"],
  #batch-form-view select,
  #batch-form-view textarea {
    width: 100%; box-sizing: border-box; padding: 8px 10px; font-size: 14px;
    border: 1px solid #d1d5db; border-radius: 6px; margin-bottom: 8px;
  }
  #batch-form-view textarea { font-family: ui-monospace, monospace; }
  #batch-form-view .field-row { display: flex; gap: 8px; margin-bottom: 8px; }
  #batch-form-view .field-row input { flex: 1; margin-bottom: 0; }
  #batch-form-view .field-row button { border: none; background: none; color: #9ca3af; font-size: 18px; cursor: pointer; }
  #batch-form-view button[type="submit"] {
    background: #2563eb; color: #fff; border: none; border-radius: 6px;
    padding: 10px 18px; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 8px;
  }
  #batch-form-view .form-errors { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; border-radius: 6px; padding: 12px; margin-bottom: 16px; }
  #batch-form-view .form-error { margin: 0 0 4px; font-size: 13px; }
  #batch-form-view .form-error:last-child { margin-bottom: 0; }
</style>
